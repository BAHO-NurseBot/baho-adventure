  /* Media Queries */
  
  /* For laptops and tablets */
  @media (min-width: 769px) {
    .App-header {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
      padding: 2rem;
    }
  
    .flex {
      flex-basis: calc(50% - 2rem); /* Adjust to display two items per row */
      justify-content: space-between;
    }
  }
  
  /* For mobile devices */
  @media (max-width: 768px) {
    .App-header {
      flex-direction: column;
      align-items: center;
      padding: 1rem;
    }
  
    .flex {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%; /* Make items stack vertically */
      margin-bottom: 1rem;
    }
  
    .flex img {
      display: none; /* Hide images on mobile */
    }
  
    .card-id, .tap, .noactivecard {
      width: 90%; /* Make text blocks fill the screen width */
    }
  
    .text-sm {
      font-size: 14px; /* Slightly smaller font size on mobile */
    }
  }
  
  
  

